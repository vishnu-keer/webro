{
  "name": "webro-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for WEBRO Studio — web, app and AI development agency.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write \"**/*.{ts,js,astro,scss,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,astro,scss,md,json}\""
  },
  "dependencies": {
    "astro": "^4.16.18",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "3.2.1",
    "@eslint/js": "^9.17.0",
    "@types/three": "^0.170.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
