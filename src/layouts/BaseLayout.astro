---
import { ViewTransitions } from 'astro:transitions';
import type { SeoProps } from '@/types';
import { site, navLinks } from '@/data/site';
import { cleanPath as normalisePath, isIndexable } from '@/data/seo';
import { services } from '@/data/services';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Loader from '@components/layout/Loader.astro';
import Backdrop from '@components/background/Backdrop.astro';
import QuickActions from '@components/layout/QuickActions.astro';
import ChatWidget from '@components/chat/ChatWidget.astro';

/**
 * Fonts are self-hosted rather than loaded from Google Fonts. The external
 * stylesheet was render-blocking on a third-party origin — two extra DNS +
 * TLS round trips before any text could paint, which is a direct LCP cost.
 * Bundling them keeps everything on one connection.
 */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/dm-sans';
// The same Latin files the CSS above uses (Vite gives both the same hashed
// URL), preloaded so they arrive before first paint. Without this the page
// paints in a fallback font, then re-flows when the web fonts swap in — the
// main cause of layout shift (CLS) measured on the homepage.
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';

import '@styles/main.scss';

type Props = SeoProps;

const { title, description, keywords, indexable = true, background, floatingActions = true } = Astro.props;

/**
 * build.format 'file' makes Astro see paths as /services.html, but the site
 * links, sitemap and GitHub Pages all serve /services. The canonical must match
 * those, or Google gets two URLs for every page and splits ranking between them.
 */
const cleanPath = normalisePath(Astro.url.pathname);
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL('/assets/og-image.png', site.url).href;
// A page is indexable only if it says so AND is not on the NOINDEX_PATHS list,
// so the robots tag and sitemap.xml can never disagree.
const indexed = indexable && isIndexable(cleanPath);
const robots = indexed
  ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  : 'noindex, follow';
const ogImageAlt = `${site.name} — ${site.tagline}`;

/**
 * The 404 page is served for every unknown URL, so it must not claim a
 * canonical address of its own (it would point at a URL that does not exist).
 */
const isErrorPage = cleanPath === '/404';

/**
 * LocalBusiness: WEBRO has a real Google Business Profile in Jaipur.
 * (schema.org marks the generic ProfessionalService type as deprecated, so it
 * is not used.)
 *
 * Only details a visitor can also see on the site are published here:
 *   - address: city, region and country, as shown on /contact and the footer.
 *     The street address and coordinates stay out until they are shown on the
 *     page and approved by the owner.
 *   - hasMap: the same "Open in Google Maps" link /contact shows.
 *   - currenciesAccepted: quotes and invoices are in USD (FAQ, terms), and
 *     UPI payments, which the FAQ lists, settle in INR. Package prices on
 *     /pricing stay USD-only.
 * No priceRange: individual package prices live in the Offer data on /pricing.
 */
const organisationSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#organization`,
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  url: site.url,
  logo: new URL('/assets/logo.png', site.url).href,
  image: ogImage,
  telephone: site.phone,
  email: site.email,
  currenciesAccepted: 'USD, INR',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: site.phone,
    email: site.email,
    url: new URL('/contact', site.url).href,
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.locality,
    addressRegion: site.location.region,
    addressCountry: site.location.country,
  },
  hasMap: site.location.mapsSearchUrl,
  areaServed: site.markets.map((name) => ({ '@type': 'Country', name })),
  sameAs: [site.instagram],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Digital Services',
    itemListElement: services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.title },
    })),
  },
};

/** Lets Google tie every page back to one named site and publisher. */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  inLanguage: 'en',
  publisher: { '@id': `${site.url}/#organization` },
};

/**
 * Breadcrumbs replace the raw URL in search results ("webro.studio › Pricing").
 * Labels come from the navigation so they always match what visitors see.
 * The homepage and non-indexable pages (404) get none.
 */
const pageLabels: Record<string, string> = {
  ...Object.fromEntries(navLinks.map((link) => [link.href, link.label])),
  '/privacy': 'Privacy Policy',
  '/terms': 'Terms of Service',
};
const path = cleanPath;
const pageLabel = pageLabels[path];
const breadcrumbSchema =
  indexed && path !== '/' && pageLabel
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: pageLabel, item: canonical },
        ],
      }
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {!isErrorPage && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F1EBDD" />

    {/* One English version serves every market, so no hreflang alternates:
        pointing several locales at the same URL tells search engines nothing. */}

    <meta property="og:type" content="website" />
    {!isErrorPage && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {/* Google needs at least 48x48 and probes /favicon.ico at the root. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/icon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/assets/icon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmSansLatin} crossorigin />

    {/* The logo is the largest element above the fold on every page. */}
    <link rel="preload" as="image" href="/assets/logo.png" />

    {/* Runs before first paint so a returning visitor never sees the splash
        flash for a frame before JavaScript removes it. */}
    <script is:inline>
      try {
        if (sessionStorage.getItem('webro:splash-seen') === '1') {
          document.documentElement.classList.add('splash-seen');
        }
      } catch {
        /* private browsing — fall through and show the splash */
      }
    </script>

    {/* Instant, seamless navigation while keeping one real URL per page —
        so each can still be indexed and ranked independently. */}
    <ViewTransitions />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organisationSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    <slot name="head" />

    {
      site.gaMeasurementId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaMeasurementId}`} />
          <script
            is:inline
            define:vars={{ id: site.gaMeasurementId }}
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${site.gaMeasurementId}')`}
          />
        </>
      )
    }
  </head>

  <body data-scene={background}>
    <Loader />
    <Backdrop />

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    {floatingActions && <QuickActions />}
    {floatingActions && <ChatWidget />}

    <script>
      import '@scripts/main';
    </script>
  </body>
</html>
