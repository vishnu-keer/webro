---
import { techLogos } from '@/data/tech';

/** Duplicated so the CSS translate(-50%) loop is seamless. */
const track = [...techLogos, ...techLogos];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      track.map((tech) => (
        <span class="chip">
          <img
            src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${tech.slug}.svg`}
            alt=""
            loading="lazy"
            width="20"
            height="20"
          />
          {tech.name}
        </span>
      ))
    }
  </div>
</div>
