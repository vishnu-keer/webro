---
/**
 * WEBRO AI. Markup only — behaviour lives in src/scripts/chat, and the
 * answers in src/scripts/chat/knowledge-base.ts.
 */
const suggestions = [
  { label: '💰 Pricing', query: 'pricing' },
  { label: '⏱️ Timeline', query: 'how long does it take' },
  { label: '🛠️ Services', query: 'services' },
  { label: '📱 Menu QR', query: 'menu qr' },
  { label: '📞 Contact', query: 'contact' },
];
---

<button
  class="chat-launcher"
  type="button"
  data-chat-launcher
  aria-expanded="false"
  aria-controls="chat-panel"
>
  <span class="chat-launcher__pulse"></span>
  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
    <path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-5a8 8 0 0 1 8-11h2a8 8 0 0 1 8 8z" />
  </svg>
  <span class="chat-launcher__label">Ask WEBRO AI</span>
</button>

<div class="chat-panel" id="chat-panel" data-chat-panel role="dialog" aria-label="WEBRO AI assistant">
  <div class="chat-panel__header">
    <img src="/assets/logo.png" alt="" width="36" height="36" />
    <div>
      <strong>WEBRO AI</strong>
      <span><i class="chat-panel__status-dot"></i> Replies instantly</span>
    </div>
    <button class="chat-panel__close" type="button" data-chat-close aria-label="Close chat">&times;</button>
  </div>

  <div class="chat-panel__log" data-chat-log role="log" aria-live="polite"></div>

  <div class="chat-panel__suggestions">
    {
      suggestions.map((item) => (
        <button type="button" data-chat-suggestion={item.query}>
          {item.label}
        </button>
      ))
    }
  </div>

  <div class="chat-panel__composer">
    <label class="visually-hidden" for="chat-input">Message WEBRO AI</label>
    <input id="chat-input" type="text" placeholder="Ask anything…" autocomplete="off" data-chat-input />
    <button type="button" data-chat-send aria-label="Send message">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M22 2 11 13M22 2l-7 20-4-9-9-4z" />
      </svg>
    </button>
  </div>
</div>
