---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import { site } from '@/data/site';
import { services } from '@/data/services';

const mapEmbed = `https://www.google.com/maps?q=${site.location.latitude},${site.location.longitude}&z=16&output=embed`;

const fields = [
  { id: 'name', label: 'Your name', type: 'text', autocomplete: 'name', placeholder: 'Jane Cooper', error: 'Please enter your name.' },
  { id: 'email', label: 'Email', type: 'email', autocomplete: 'email', placeholder: 'jane@company.com', error: 'Please enter a valid email address.' },
  { id: 'phone', label: 'Phone / WhatsApp', type: 'tel', autocomplete: 'tel', placeholder: '+1 555 000 1234', error: 'Please enter a valid phone number.' },
] as const;
---

<BaseLayout
  title="Contact WEBRO | Free Quote Within One Business Day"
  description="Call +91 63770 93356, message on WhatsApp, or send the form. WEBRO Studio, Jaipur — working with clients worldwide. We reply within one business day."
  keywords="contact web design agency, hire web developer india, website quote, web design jaipur contact, whatsapp web developer"
  background="globe"
>
  <div class="container">
    <div class="page-head">
      <SectionHeader
        level={1}
        eyebrow="Contact"
        title="Let's talk about your project"
        description="Tell us what you're building and what success looks like. We reply within one business day."
      />
    </div>

    <section class="section" style="padding-block-start:0">
      <div class="grid grid--2">
        <div class="contact-info reveal">
          <div class="contact-info__row">
            <div class="contact-info__icon">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
              </svg>
            </div>
            <div>
              <strong>Call or WhatsApp</strong>
              <span><a href={`tel:${site.phone}`}>{site.phoneDisplay}</a></span>
            </div>
          </div>

          <div class="contact-info__row">
            <div class="contact-info__icon">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
              </svg>
            </div>
            <div>
              <strong>Email</strong>
              <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
            </div>
          </div>

          <div class="contact-info__row">
            <div class="contact-info__icon">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" />
              </svg>
            </div>
            <div>
              <strong>Instagram</strong>
              <span><a href={site.instagram} target="_blank" rel="noopener">@webro.studio</a></span>
            </div>
          </div>

          <div class="contact-info__row">
            <div class="contact-info__icon">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
            </div>
            <div>
              <strong>Studio location</strong>
              <span>
                WEBRO Studio, {site.location.locality}, {site.location.region}, India<br />
                <a href={site.location.mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a>
              </span>
            </div>
          </div>

          <div class="map-embed">
            <iframe
              title="WEBRO Studio location on Google Maps"
              src={mapEmbed}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>

        <div class="reveal">
          <form class="panel" style="text-align:left;padding:1.75rem" data-contact-form novalidate>
            {
              fields.map((field) => (
                <div class="field" data-invalid="false">
                  <label for={field.id}>{field.label}</label>
                  <input
                    id={field.id}
                    name={field.id}
                    type={field.type}
                    autocomplete={field.autocomplete}
                    placeholder={field.placeholder}
                  />
                  <span class="field__error">{field.error}</span>
                </div>
              ))
            }

            <div class="field" data-invalid="false">
              <label for="service">What do you need?</label>
              <select id="service" name="service">
                <option value="">Select a service</option>
                {services.map((service) => <option>{service.title}</option>)}
                <option>Something else</option>
              </select>
              <span class="field__error">Please choose a service.</span>
            </div>

            <div class="field" data-invalid="false">
              <label for="message">Project details</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                placeholder="What are you building, and what does success look like?"></textarea>
              <span class="field__error">Tell us a little more.</span>
            </div>

            <button class="btn btn--primary btn--block" type="submit">Send enquiry</button>

            <div class="form-status" data-form-status role="status">
              <strong>Thanks! We'll reply within one business day.</strong><br />
              <span style="font-size:0.82rem">
                Prefer instant? WhatsApp us on {site.phoneDisplay}.
              </span>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
