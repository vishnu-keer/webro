---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — WEBRO"
  description="That page does not exist."
  indexable={false}
>
  <div class="container">
    <section class="section" style="text-align:center;padding-block:5rem">
      <span class="eyebrow">Error 404</span>
      <h1>This page moved on</h1>
      <p class="lead" style="margin:1rem auto 1.75rem">
        The link is broken or the page no longer exists. Everything worth seeing is one click away.
      </p>
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/">Back home</a>
        <a class="btn btn--ghost" href="/services">See services</a>
      </div>
    </section>
  </div>
</BaseLayout>
