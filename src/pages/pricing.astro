---
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/ui/SectionHeader.astro';
import PlanCard from '@components/ui/PlanCard.astro';
import { projectPlans, monthlyPlans } from '@/data/pricing';
import { site } from '@/data/site';
import type { Plan } from '@/types';

/**
 * The plans on this page as schema.org Offers. Prices are read from the same
 * data the cards render, so the markup can never drift from what is shown.
 * Wording that a single number cannot express ("starting at", "setup + $19/mo")
 * is kept verbatim in `description`.
 */
const toOffer = (plan: Plan) => {
  const amount = Number(plan.price.replace(/[^0-9.]/g, ''));
  const monthly = plan.cadence === '/month';
  const from = plan.cadence === 'starting at';
  return {
    '@type': 'Offer',
    name: plan.name,
    description: `${plan.summary} ${plan.price} ${plan.cadence}.`,
    priceCurrency: 'USD',
    ...(from
      ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: amount, priceCurrency: 'USD' } }
      : monthly
        ? {
            price: amount,
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              price: amount,
              priceCurrency: 'USD',
              unitCode: 'MON',
            },
          }
        : { price: amount }),
    seller: { '@id': `${site.url}/#organization` },
  };
};

const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'WEBRO Studio pricing',
  url: new URL('/pricing', site.url).href,
  itemListElement: [...projectPlans, ...monthlyPlans].map(toOffer),
};
---

<BaseLayout
  title="Website Development Pricing from $499 | WEBRO Studio"
  description="Transparent fixed pricing from $499. Website, e-commerce and app packages plus monthly Instagram management, Menu QR and Review QR plans. No hourly billing."
  keywords="website design cost, web development pricing, how much does a website cost, app development cost, instagram management pricing, menu qr price, affordable web design agency"
  background="columns"
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(pricingSchema)} />
  <div class="container">
    <div class="page-head">
      <SectionHeader
        level={1}
        eyebrow="Pricing"
        title="Transparent pricing in USD"
        description="Fixed quotes agreed before work starts. No hourly billing, no surprise invoices."
      />
    </div>

    <section class="section" style="padding-block-start:0">
      <div class="grid grid--3">
        {projectPlans.map((plan) => <PlanCard plan={plan} />)}
      </div>
      <p style="margin-top:1.125rem;font-size:0.88rem;color:var(--ink-soft, #5b5848)">
        All prices in USD. Custom platforms and larger builds are quoted after a short scoping call.
      </p>
    </section>

    <section class="section" style="padding-block-start:0">
      <SectionHeader
        eyebrow="Monthly services"
        title="Ongoing growth plans"
        description="Recurring work that compounds — content, reviews and automation that keep working after launch."
      />
      <div class="grid grid--3">
        {monthlyPlans.map((plan) => <PlanCard plan={plan} />)}
      </div>
    </section>
  </div>
</BaseLayout>
