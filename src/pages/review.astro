---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@/data/site';
// One list shared with the Worker, so the buttons and the validation never drift.
import { INPUT_LIMITS, LIKED, SERVICES } from '../../worker/src/options';

/**
 * Tap-to-review helper.
 *
 * Customers tap what we did and what they liked, optionally add a line, and
 * the AI writes a polished review from exactly those choices. They then copy
 * it, open Google, choose their own rating and post it themselves. Nothing is
 * posted automatically and no rating is ever chosen for them.
 */
const { googleReviewUrl, apiUrl, geminiTier } = site.review;
const aiEnabled = apiUrl !== '';

const privacyNotice =
  geminiTier === 'free'
    ? "Your choices and note are sent to Google's Gemini AI to write the review (free tier: Google may use them to improve its products, and reviewers may read them). Don't include names or phone numbers. We store nothing."
    : "Your choices and note are sent to Google's Gemini AI to write the review. Google does not use them to improve its products. Don't include names or phone numbers. We store nothing.";
---

<BaseLayout
  title="Review WEBRO Studio — Share Your Experience"
  description="Leave a Google review for WEBRO Studio in under a minute. Tap what we did, tap what you liked, and get a ready-to-post review."
  indexable={false}
  floatingActions={false}
>
  <div class="container review">
    <header class="review__head">
      <span class="eyebrow">{site.name}</span>
      <h1>Share Your Experience</h1>
      <p>
        Takes under a minute. Tap a few options — AI turns your choices into a clear, professional
        review you can post on Google.
      </p>
    </header>

    <section class="review__body">
      <form
        class="panel review__panel"
        data-review-form
        data-api-url={apiUrl}
        novalidate
        hidden={!aiEnabled}
        aria-describedby="review-privacy"
      >
        <fieldset class="review__step" data-step="service">
          <legend
            ><span class="review__num" aria-hidden="true">1</span>What did we do for you?</legend
          >
          <div class="review__chips">
            {
              SERVICES.map((service, i) => (
                <label class="pick">
                  <input type="radio" name="service" value={service} required={i === 0} />
                  <span>{service}</span>
                </label>
              ))
            }
          </div>
          <div class="field review__other" data-other-wrap hidden>
            <label for="review-other">Which service?</label>
            <input
              id="review-other"
              name="otherService"
              type="text"
              maxlength={INPUT_LIMITS.otherService.max}
              autocomplete="off"
              placeholder="e.g. Brochure design"
            />
          </div>
          <p class="review__error" data-error-for="service" hidden>
            Please choose what we did for you.
          </p>
        </fieldset>

        <fieldset class="review__step" data-step="liked">
          <legend
            ><span class="review__num" aria-hidden="true">2</span>What did you like? <small
              >Tap all that are true</small
            ></legend
          >
          <div class="review__chips">
            {
              LIKED.map((point) => (
                <label class="pick pick--check">
                  <input type="checkbox" name="liked" value={point} />
                  <span>{point}</span>
                </label>
              ))
            }
          </div>
          <p class="review__error" data-error-for="liked" hidden>
            Please tap at least one thing you liked, or write a short note below.
          </p>
        </fieldset>

        <fieldset class="review__step">
          <legend
            ><span class="review__num" aria-hidden="true">3</span>Anything to add? <small
              >Optional</small
            ></legend
          >
          <div class="field">
            <label class="visually-hidden" for="review-note">Anything to add</label>
            <textarea
              id="review-note"
              name="note"
              rows="3"
              maxlength={INPUT_LIMITS.note.max}
              placeholder="A result, a detail, or something we could do better"></textarea>
          </div>
        </fieldset>

        <fieldset class="review__step review__step--lang">
          <legend>Review language</legend>
          <div class="review__chips">
            <label class="pick"
              ><input type="radio" name="language" value="en" checked /><span>English</span></label
            >
            <label class="pick"
              ><input type="radio" name="language" value="hi" /><span lang="hi">हिन्दी</span></label
            >
          </div>
        </fieldset>

        <button class="btn btn--primary btn--block review__go" type="submit" data-review-generate>
          Write my review
        </button>

        <div class="review__status" data-review-status role="status" aria-live="polite"></div>

        <p class="review__note" id="review-privacy">{privacyNotice}</p>
      </form>

      <div class="panel review__panel review__result" data-review-result hidden={aiEnabled}>
        <div class="field">
          <label for="review-draft" data-draft-label>
            {aiEnabled ? 'Your review — edit anything you like' : 'Write your review'}
          </label>
          <textarea
            id="review-draft"
            name="draft"
            rows="9"
            maxlength="4000"
            placeholder="Write about your experience in your own words."></textarea>
        </div>

        <p class="review__notice" data-ai-notice hidden>
          AI helped prepare this draft. Please ensure it accurately reflects your genuine experience
          before posting.
        </p>

        <div class="review__actions">
          <button class="btn btn--primary" type="button" data-review-copy>1. Copy Review</button>
          <a
            class="btn btn--ghost"
            href={googleReviewUrl}
            target="_blank"
            rel="noopener"
            data-review-open
          >
            2. Open Google Reviews
          </a>
        </div>

        <div class="review__copy-status" data-copy-status role="status" aria-live="polite"></div>

        <p class="review__howto">
          On Google: paste the text, check it, choose your own star rating and tap <strong
            >Post</strong
          >.
        </p>

        {
          aiEnabled && (
            <div class="review__more">
              <button class="review__back" type="button" data-review-regenerate>
                ↻ Write it differently
              </button>
              <button class="review__back" type="button" data-review-back>
                ← Change my answers
              </button>
            </div>
          )
        }
      </div>

      <p class="review__direct">
        Prefer to write it yourself? <a href={googleReviewUrl} target="_blank" rel="noopener"
          >Go straight to Google</a
        >.
      </p>
    </section>
  </div>
</BaseLayout>
